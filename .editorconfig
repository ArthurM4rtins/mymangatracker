# Editor, antes do Git (#277).
#
# O `.gitattributes` da #247 conserta a quebra de linha, mas so no `add` — tarde
# demais para quem esta revisando o proprio diff. Isto diz a mesma coisa ao
# editor, na hora de salvar, e cobre o que o Git nao cobre: recuo e charset.
#
# Nao inventa convencao. Cada linha abaixo descreve o que o repo ja faz hoje:
# zero tabs em ts, tsx, css, json, md, mjs e yml; passo de 2; newline final em
# todo arquivo de texto; e espaco no fim de linha em nenhum lugar.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
