# Copiar para `.env` e preencher. O `.env` e ignorado pelo Git — nunca commitar.

# Banco local: sobe com `docker compose up -d`, credenciais iguais as do docker-compose.yml.
# Em producao a Vercel injeta DATABASE_URL pela integracao Neon — nao definir la a mao.
DATABASE_URL="postgresql://mymangatracker:mymangatracker@localhost:5432/mymangatracker?schema=public"

# Segredo do JWT de sessao (cookie httpOnly, assinado com `jose`).
# Gerar um valor proprio: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Quantos proxies confiaveis anexam ao x-forwarded-for antes do app (#141).
# Um na Vercel. So mude se houver CDN ou balanceador na frente da Vercel.
IP_HOPS_CONFIAVEIS=1

# Pepper do HMAC das chaves da tabela de tentativas (#148, item 5). Opcional: sem
# ele as chaves continuam estaveis, so nao resistem a um dump do banco. Definir em
# producao. Gerar: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
LIMITE_PEPPER=""

# Banco dos testes de repositorio. Precisa terminar em `_test`: a suite apaga e
# recria dados, e o script recusa rodar contra qualquer outro nome.
# Criar uma vez: docker compose exec postgres createdb -U mymangatracker mymangatracker_test
DATABASE_URL_TEST="postgresql://mymangatracker:mymangatracker@localhost:5432/mymangatracker_test?schema=public"
