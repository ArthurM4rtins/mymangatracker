{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyMangaTracker story structure",
  "type": "object",
  "required": ["schemaVersion", "media", "curation", "sources", "segments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "media": {
      "type": "object",
      "required": ["anilistId", "title"],
      "properties": {
        "anilistId": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "curation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["VERIFIED", "DRAFT", "DISPUTED", "INSUFFICIENT_EVIDENCE", "NOT_APPLICABLE"] }
      }
    },
    "sources": { "type": "array" },
    "segments": { "type": "array", "items": { "type": "object", "oneOf": [
      { "required": ["range"] },
      { "required": ["ranges"], "properties": { "ranges": { "type": "array", "minItems": 1 } } }
    ] } }
  }
}
