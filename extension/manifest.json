{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_nome__",
  "version": "0.1.0",
  "description": "__MSG_descricao__",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_acaoTitulo__",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png",
      "128": "icones/icone-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "tabs", "cookies", "storage"],
  "host_permissions": [
    "https://mymangatracker.vercel.app/*",
    "http://localhost:3000/*"
  ]
}
