{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_nome__",
  "version": "0.1.0",
  "description": "__MSG_descricao__",
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_acaoTitulo__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "tabs", "cookies", "storage"],
  "host_permissions": [
    "https://mymangatracker.vercel.app/*",
    "http://localhost:3000/*"
  ]
}
