// Modelo do painel 06 da apresentação. Só as entidades da Fase 1 — o resto
// (Entry, List, ListItem, Follow, MediaRequest) entra por migration aditiva
// quando tiver tela que use.
//
// A URL do banco não fica aqui: vem de `prisma7.config.ts`, que lê DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

// Formato da obra. Manhwa e manhua não entram aqui — a distinção é
// `countryOfOrigin`, como no AniList. Deixar o formato separado é o que permite
// `ANIME` e `LIVE_ACTION` depois por ALTER TYPE, que é aditivo.
enum MediaType {
  MANGA
  NOVEL
}

enum CountryOfOrigin {
  JP
  KR
  CN
}

enum ShelfStatus {
  READING
  COMPLETED
  PLANNED
  PAUSED
  DROPPED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Foto de perfil (issue #76): 256x256 JPEG recortado no navegador, guardada
  // aqui porque a Vercel nao tem disco. Os bytes so saem pela rota de imagem.
  avatar          Bytes?
  avatarMime      String?
  avatarUpdatedAt DateTime?

  shelfEntries     ShelfEntry[]
  readingSources   ReadingSource[]
  readingProgress  ReadingProgress[]
  entries          Entry[]
  reviewLikes      ReviewLike[]
  reviewComments   ReviewComment[]
  lists            List[]
  listLikes        ListLike[]
  seguindo         Follow[]          @relation("Seguidor")
  seguidores       Follow[]          @relation("Seguido")
  perfisCurtidos   ProfileLike[]     @relation("QuemCurtiu")
  curtidasDoPerfil ProfileLike[]     @relation("PerfilCurtido")
}

// Seguir (issue #74): quem segue quem. Um vínculo por par; apagar qualquer
// dos dois leva o vínculo junto. O CHECK de não seguir a si mesmo está à mão
// na migration.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Seguidor", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Seguido", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// Curtida de perfil (issue #74): igual à ListLike, só número. CHECK de não
// curtir o próprio perfil à mão na migration.
model ProfileLike {
  id            String   @id @default(cuid())
  userId        String
  profileUserId String
  createdAt     DateTime @default(now())

  user    User @relation("QuemCurtiu", fields: [userId], references: [id], onDelete: Cascade)
  profile User @relation("PerfilCurtido", fields: [profileUserId], references: [id], onDelete: Cascade)

  @@unique([userId, profileUserId])
  @@index([profileUserId])
}

// Lista nomeada de obras (painel 06). Pública desde o início — recorte do
// social: username do dono, nunca e-mail. Nome não é único, como no
// Letterboxd; o CHECK de não-vazio está à mão na migration.
model List {
  id        String   @id @default(cuid())
  userId    String
  nome      String
  descricao String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itens ListItem[]
  likes ListLike[]

  // /listas (públicas, mais recentes) e as listas do dono, na mesma direção.
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// Uma obra por lista; ordem = posição de inserção.
model ListItem {
  id        String   @id @default(cuid())
  listId    String
  mediaId   String
  position  Int
  createdAt DateTime @default(now())

  list  List  @relation(fields: [listId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([listId, mediaId])
  @@index([listId, position])
}

// Curtida numa lista (issue #51): uma por (listId, userId), toggle. Cascade
// dos dois lados; só a contagem é pública.
model ListLike {
  id        String   @id @default(cuid())
  listId    String
  userId    String
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  // O perfil conta curtidas dadas por usuário.
  @@index([userId])
}

// Cache do AniList. Se sumir, é reconstruído da API — nenhum dado do usuário
// se perde junto, e é por isso que as FKs que apontam para cá são Restrict.
model Media {
  id              String           @id @default(cuid())
  anilistId       Int              @unique
  type            MediaType
  countryOfOrigin CountryOfOrigin?
  titleRomaji     String
  titleEnglish    String?
  titleNative     String?
  coverImageUrl   String?
  description     String?
  chapters        Int?
  // Campos da página da obra (issue #35). Tudo anulável: linha velha continua
  // válida e é reidratada pelo TTL de 24h.
  bannerImageUrl  String?
  startYear       Int?
  genres          String[]         @default([])
  averageScore    Int?
  // [{anilistStaffId, nome, papel}] — tabela própria só quando a página do
  // autor existir; até lá o Json evita entidade sem tela.
  authors         Json?
  syncedAt        DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  shelfEntries    ShelfEntry[]
  readingSources  ReadingSource[]
  readingProgress ReadingProgress[]
  entries         Entry[]
  listItems       ListItem[]
}

// A avaliação do usuário: nota e/ou resenha, uma por obra (painel 06).
// Nota 0,5–5,0 em passos de 0,5 — o CHECK está à mão na migration, porque
// não sai do schema do Prisma. Visível só ao dono até a fase social.
model Entry {
  id               String   @id @default(cuid())
  userId           String
  mediaId          String
  rating           Decimal? @db.Decimal(2, 1)
  review           String?  @db.Text
  containsSpoilers Boolean  @default(false)
  reviewedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  likes       ReviewLike[]
  comentarios ReviewComment[]

  @@unique([userId, mediaId])
  // Página da obra: resenhas públicas e histograma de notas filtram só por mediaId.
  // O feed da home (reviewedAt DESC WHERE review IS NOT NULL) é índice parcial,
  // escrito à mão na migration indices_consultas.
  @@index([mediaId])
}

// Curtida numa resenha: uma por (entryId, userId), toggle. Apagar a resenha ou
// a conta leva as curtidas junto — Cascade dos dois lados.
model ReviewLike {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  createdAt DateTime @default(now())

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  // O perfil conta curtidas dadas por usuário.
  @@index([userId])
}

// Comentário numa resenha: sequência cronológica plana, tipo chat. O CHECK de
// texto não-vazio está à mão na migration.
model ReviewComment {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  texto     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
}

// O resumo da linha do tempo: uma linha por obra por usuário.
model ShelfEntry {
  id              String      @id @default(cuid())
  userId          String
  mediaId         String
  status          ShelfStatus
  progressChapter Decimal?    @db.Decimal(8, 2)
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([userId, mediaId])
  @@index([userId, status])
}

// PRIVADO DO DONO. O que o usuário escreve: onde ele lê.
// Toda consulta carrega userId — invariante do sistema, não preferência.
model ReadingSource {
  id          String    @id @default(cuid())
  userId      String
  mediaId     String
  sourceHost  String
  urlTemplate String
  isActive    Boolean   @default(true)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  readingProgress ReadingProgress[]

  // O índice único PARCIAL — muitas fontes por obra, só uma ativa — o Prisma não
  // gera. Está escrito à mão na migration.
  @@index([userId, mediaId])
}

// PRIVADO DO DONO. O que o sistema grava: qual capítulo, quando, por qual fonte.
// O progresso pertence à obra, não ao site: por isso readingSourceId é anulável
// com SetNull — trocar ou apagar a fonte não apaga o histórico.
model ReadingProgress {
  id              String   @id @default(cuid())
  userId          String
  mediaId         String
  readingSourceId String?
  chapter         Decimal  @db.Decimal(8, 2)
  resolvedUrl     String
  openedAt        DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  media         Media          @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  readingSource ReadingSource? @relation(fields: [readingSourceId], references: [id], onDelete: SetNull)

  // "Qual foi o último capítulo aberto" é a consulta mais frequente do app.
  // O índice nasce na direção dela.
  @@index([userId, mediaId, openedAt(sort: Desc)])
}
